<UserControl
    x:Class="SaySo.Settings.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="32,24,32,32" Spacing="12" MaxWidth="820" HorizontalAlignment="Stretch">
            <TextBlock Text="SaySo" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="VersionText" Style="{StaticResource CardDescription}" />
            <TextBlock TextWrapping="Wrap"
                       Text="Зажмите клавишу, говорите, отпустите — очищенный текст появится в активном окне. Распознавание: Gemini 3.5 Transcribe (режим SMART), резерв — Groq Whisper." />

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Обновления" Style="{StaticResource CardTitle}" />
                    <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Style="{StaticResource CardDescription}"
                               Text="Нажмите «Проверить обновления»." />
                    <TextBlock x:Name="UpdateNotes" TextWrapping="Wrap" MaxLines="8" Style="{StaticResource CardDescription}"
                               Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="CheckButton" Content="Проверить обновления" Click="OnCheckUpdates" />
                        <Button x:Name="InstallButton" Content="Обновить" Style="{StaticResource AccentButtonStyle}"
                                Visibility="Collapsed" Click="OnInstallUpdate" />
                        <ProgressRing x:Name="UpdateRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Как получить ключ Gemini" Style="{StaticResource CardTitle}" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CardDescription}"
                               Text="1. Откройте Google AI Studio (из России — с включённым VPN) и войдите в аккаунт Google.&#10;2. Нажмите «Create API key», скопируйте ключ и вставьте в «Распознавание».&#10;3. Свои лимиты бесплатного тарифа смотрите в AI Studio → Rate limits: Google не публикует общих цифр для этой модели." />
                    <HyperlinkButton Content="Google AI Studio — ключи" NavigateUri="https://aistudio.google.com/apikey" Padding="0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Конфиденциальность" Style="{StaticResource CardTitle}" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CardDescription}"
                               Text="Аудио не сохраняется на диск. Аудио и термины словаря отправляются в Google Gemini; если сработал резерв, аудио, расшифровка и термины словаря уходят в Groq; проверка ключей тоже обращается к этим API. Проверка обновлений обращается к GitHub: уходит только запрос о последнем релизе и скачивание файла, ключи и тексты не отправляются. Ключи и история хранятся локально, зашифрованы средствами Windows (DPAPI). На бесплатном тарифе Gemini Google может использовать запросы для улучшения своих продуктов." />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <HyperlinkButton Content="Исходный код на GitHub" NavigateUri="https://github.com/Denmurzik/SaySo" />
                <HyperlinkButton Content="Папка данных и журнал" Click="OnOpenDataFolder" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
