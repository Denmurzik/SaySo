<UserControl
    x:Class="SaySo.Settings.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="32,24,32,32" Spacing="8" MaxWidth="820" HorizontalAlignment="Stretch">
            <TextBlock Text="Общие" Style="{StaticResource PageTitle}" />
            <InfoBar x:Name="Info" IsOpen="False" IsClosable="True" />

            <Border Style="{StaticResource SettingsCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Горячая клавиша" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource CardDescription}"
                                   Text="Пока клавиша удерживается, идёт запись; отпустите, и текст вставится. Короткое нажатие включает режим «руки свободны», повторное завершает запись. Отмена: Esc." />
                    </StackPanel>
                    <Button x:Name="HotkeyButton" Grid.Column="1" MinWidth="180" VerticalAlignment="Center" Click="OnHotkeyClick" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Короткое нажатие" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Нажатие короче этого порога включает режим «руки свободны»." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Slider x:Name="TapSlider" Width="220" Minimum="150" Maximum="1000" StepFrequency="50" ValueChanged="OnTapChanged" />
                        <TextBlock x:Name="TapValue" MinWidth="60" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Звуковые сигналы" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Короткие сигналы начала и конца записи и ошибки." />
                    </StackPanel>
                    <ToggleSwitch x:Name="SoundsSwitch" Grid.Column="1" OnContent="Вкл" OffContent="Выкл" Toggled="OnSoundsToggled" />
                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Звуки" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox x:Name="SoundThemeBox" MinWidth="180" AutomationProperties.Name="Звуки" SelectionChanged="OnSoundThemeChanged" />
                            <Button x:Name="SoundPreviewButton" Content="Прослушать" Click="OnSoundPreviewClick" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Запускать вместе с Windows" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="AutostartHint" Style="{StaticResource CardDescription}" Text="SaySo тихо живёт в области уведомлений." />
                    </StackPanel>
                    <ToggleSwitch x:Name="AutostartSwitch" Grid.Column="1" OnContent="Вкл" OffContent="Выкл" Toggled="OnAutostartToggled" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Значок в трее" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource CardDescription}"
                                   Text="Если значок скрыт, SaySo продолжает работать. Чтобы открыть настройки, запустите SaySo ещё раз из меню «Пуск»." />
                    </StackPanel>
                    <ToggleSwitch x:Name="TraySwitch" Grid.Column="1" OnContent="Вкл" OffContent="Выкл" Toggled="OnTrayToggled" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Прозрачность плашки" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource CardDescription}"
                                   Text="Насколько просвечивают окна под плашкой. Не действует, если в Windows выключены эффекты прозрачности." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Slider x:Name="TransparencySlider" Width="220" Minimum="0" Maximum="100" StepFrequency="5" ValueChanged="OnTransparencyChanged" />
                        <TextBlock x:Name="TransparencyValue" MinWidth="60" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Проверять обновления автоматически" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource CardDescription}"
                                   Text="Раз в сутки SaySo спрашивает у GitHub, нет ли новой версии. Ключи и тексты диктовок не отправляются. Проверить вручную можно на странице «О программе»." />
                    </StackPanel>
                    <ToggleSwitch x:Name="UpdatesSwitch" Grid.Column="1" OnContent="Вкл" OffContent="Выкл" Toggled="OnUpdatesToggled" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Запускать от имени администратора" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource CardDescription}"
                                   Text="Нужно, чтобы вставлять текст в окна, запущенные от администратора (терминалы, IDE). Автозапуск тогда идёт через Планировщик заданий; потребуется подтверждение UAC." />
                        <TextBlock x:Name="AdminWarning" Style="{StaticResource CardDescription}" Margin="0,6,0,0"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   Text="Повышенные права получит SaySo.exe из папки, куда могут писать программы вашей учётной записи. Включайте, только если доверяете установленным программам." />
                    </StackPanel>
                    <ToggleSwitch x:Name="AdminSwitch" Grid.Column="1" OnContent="Вкл" OffContent="Выкл" Toggled="OnAdminToggled" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
